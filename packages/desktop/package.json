{
  "name": "@dinkster/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dinkster Desktop Electron shell and local engine lifecycle",
  "author": "Dinkster contributors",
  "repository": "https://github.com/Kosinkadink/Dinkster-Frontend.git",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/clean-output.mjs dist && tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:all": "pnpm --filter @dinkster/app build && pnpm build",
    "prepare:engine": "node scripts/prepare-engine-source.mjs",
    "package:win": "pnpm prepare:engine && pnpm build:all && node scripts/clean-output.mjs release && electron-builder --win nsis --publish never",
    "verify:update-feed": "node scripts/verify-update-feed.mjs",
    "verify:installed": "pnpm --filter @dinkster/e2e exec node --import tsx scripts/verify-desktop-install.mjs",
    "start": "pnpm build:all && electron .",
    "start:web": "pnpm --filter @dinkster/app build && tsx src/web-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.0.4",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "http-proxy": "^1.18.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.10.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "fflate": "0.8.3",
    "js-yaml": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.dinkster.desktop",
    "productName": "Dinkster Desktop",
    "protocols": [{ "name": "Dinkster", "schemes": ["dinkster"] }],
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app"
      },
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": ["*.zip", "*.whl"]
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [{ "provider": "generic", "url": "https://updates.dinkster.invalid/desktop" }],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "artifactName": "Dinkster-Desktop-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
