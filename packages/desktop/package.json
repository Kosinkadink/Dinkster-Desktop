{
  "name": "@dinkster/desktop",
  "productName": "Dinkster Desktop",
  "desktopName": "dinkster-desktop.desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dinkster Desktop Electron shell and local engine lifecycle",
  "author": "Dinkster contributors",
  "repository": "https://github.com/Kosinkadink/Dinkster-Desktop.git",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/clean-output.mjs dist && tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:all": "pnpm --dir ../.. prepare:frontend && pnpm build",
    "package:win": "pnpm build:all && node scripts/clean-output.mjs release && electron-builder --win nsis --publish never",
    "package:win:signed": "pnpm package:win --config electron-builder.signed.mjs",
    "verify:update-feed": "node scripts/verify-update-feed.mjs",
    "verify:installed": "pnpm --filter @dinkster/e2e exec node --import tsx scripts/verify-desktop-install.mjs",
    "start": "pnpm build:all && electron .",
    "start:web": "pnpm --dir ../.. prepare:frontend && tsx src/web-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.0.4",
    "electron-updater": "^6.6.2",
    "extract-zip": "2.0.1",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.10.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "js-yaml": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.dinkster.desktop",
    "protocols": [
      {
        "name": "Dinkster",
        "schemes": [
          "dinkster"
        ]
      }
    ],
    "asar": true,
    "files": [
      "dist/**/*",
      "resources/projects.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app"
      },
      {
        "from": "resources/branding",
        "to": "branding"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.dinkster.invalid/desktop"
      }
    ],
    "win": {
      "icon": "resources/branding/platform/dinkster.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "artifactName": "Dinkster-Desktop-${version}-Setup.${ext}"
    },
    "nsis": {
      "installerIcon": "resources/branding/platform/dinkster.ico",
      "uninstallerIcon": "resources/branding/platform/dinkster.ico",
      "installerHeaderIcon": "resources/branding/platform/dinkster.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "resources/branding/platform/dinkster.icns",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "icon": "resources/branding/raster/color/512.png",
      "executableName": "dinkster-desktop",
      "category": "Graphics",
      "desktop": {
        "entry": { "StartupWMClass": "Dinkster Desktop" }
      }
    }
  }
}
