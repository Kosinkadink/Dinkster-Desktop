{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.AsyncIterable"],
    "types": ["node", "electron"],
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"]
}
